{
  "name": "@juggleai/jugglework-desktop-workspace",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "JUGGLEWORK_DEV_MODE=1 JUGGLEWORK_ELECTRON_REMOTE_DEBUG_PORT=${JUGGLEWORK_ELECTRON_REMOTE_DEBUG_PORT:-9823} pnpm --filter @jugglework/desktop dev",
    "dev:electron": "JUGGLEWORK_DEV_MODE=1 pnpm --filter @jugglework/desktop dev:electron",
    "dev:electron:two": "JUGGLEWORK_DEV_MODE=1 node scripts/dev-two-electron-demo.mjs",
    "demo:electron": "JUGGLEWORK_DEV_MODE=1 node scripts/dev-two-electron-demo.mjs --reset",
    "demo:electron:build": "node scripts/build-two-electron-demo.mjs",
    "demo:electron:reset": "node scripts/dev-two-electron-demo.mjs --reset-only",
    "demo:reset": "pnpm demo:electron:reset",
    "dev:sandbox": "bash .devcontainer/dev-sandbox.sh",
    "dev:ui": "JUGGLEWORK_DEV_MODE=1 pnpm --filter @jugglework/app dev",
    "dev:ui-demo": "pnpm --filter @jugglework/ui-demo dev",
    "email:dev": "pnpm --filter @jugglework/email dev",
    "dev:headless-web": "JUGGLEWORK_DEV_MODE=1 bun scripts/dev-headless-web.ts",
    "build": "node scripts/build.mjs",
    "build:ui": "pnpm --filter @jugglework/app build",
    "preview": "pnpm --filter @jugglework/app preview",
    "typecheck": "pnpm --filter @jugglework/app typecheck",
    "check:enterprise-mcp-mock-server": "pnpm --filter @jugglework/enterprise-mcp-mock-server check",
    "test:health": "pnpm --filter @jugglework/app test:health",
    "test:sessions": "pnpm --filter @jugglework/app test:sessions",
    "test:refactor": "pnpm --filter @jugglework/app test:refactor",
    "test:events": "pnpm --filter @jugglework/app test:events",
    "test:todos": "pnpm --filter @jugglework/app test:todos",
    "test:permissions": "pnpm --filter @jugglework/app test:permissions",
    "test:session-error-recovery": "pnpm --filter @jugglework/app test:session-error-recovery",
    "test:session-scope": "pnpm --filter @jugglework/app test:session-scope",
    "test:session-switch": "pnpm --filter @jugglework/app test:session-switch",
    "test:fs-engine": "pnpm --filter @jugglework/app test:fs-engine",
    "test:eval-runner": "pnpm evals:test",
    "test:e2e": "pnpm --filter @jugglework/app test:e2e",
    "evals": "node evals/runner/run.mjs --mode automation",
    "fraimz": "node evals/runner/run.mjs --mode demo",
    "evals:typecheck": "tsc -p evals",
    "evals:test": "node --test evals/runner/context.test.ts",
    "bump:patch": "pnpm --filter @jugglework/app bump:patch",
    "bump:minor": "pnpm --filter @jugglework/app bump:minor",
    "bump:major": "pnpm --filter @jugglework/app bump:major",
    "bump:set": "pnpm --filter @jugglework/app bump:set",
    "release:review": "node scripts/release/review.mjs",
    "release:prepare": "node scripts/release/prepare.mjs",
    "release:prepare:dry": "node scripts/release/prepare.mjs --dry-run",
    "release:ship": "node scripts/release/ship.mjs",
    "release:ship:watch": "node scripts/release/ship.mjs --watch"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "turbo": "^2.5.5",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@11.4.0"
}

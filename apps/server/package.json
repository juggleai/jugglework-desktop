{
  "name": "jugglework-server",
  "version": "1.2.0",
  "description": "Filesystem-backed API for JuggleWork remote clients",
  "type": "module",
  "bin": {
    "jugglework-server": "bin/jugglework-server.mjs"
  },
  "scripts": {
    "dev": "JUGGLEWORK_DEV_MODE=1 bun src/cli.ts",
    "test": "bun test",
    "test:artifacts": "bun test src/artifact-files.e2e.test.ts src/workspace-init.test.ts src/server.normalizeWorkspaceRelativePath.test.ts",
    "clean": "node script/clean-dist.mjs",
    "build": "pnpm clean && tsc -p tsconfig.build.json && bun build src/opencode-plugins/jugglework-extensions-preview.ts src/opencode-plugins/jugglework-capabilities-knowledge.ts src/opencode-plugins/jugglework-office-attachments.ts src/opencode-plugins/jugglework-anthropic-adaptive-thinking.ts src/opencode-plugins/jugglework-anthropic-tool-schema.ts src/opencode-plugins/jugglework-safe-grep.ts src/opencode-plugins/jugglework-context-overflow.ts --outdir dist/opencode-plugins --target node --format esm",
    "build:bin": "bun build --compile src/cli.ts --outfile dist/bin/jugglework-server",
    "build:bin:all": "bun ./script/build.ts --outdir dist/bin --target bun-darwin-arm64 --target bun-darwin-x64 --target bun-linux-x64 --target bun-linux-arm64 --target bun-windows-x64 --target bun-windows-arm64",
    "start": "bun dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:package-content": "node --test script/package-content.test.mjs",
    "prepublishOnly": "pnpm build && pnpm build:bin"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juggleai/jugglework-desktop.git",
    "directory": "apps/server"
  },
  "homepage": "https://github.com/juggleai/jugglework-desktop/tree/dev/apps/server",
  "bugs": {
    "url": "https://github.com/juggleai/jugglework-desktop/issues"
  },
  "keywords": [
    "jugglework",
    "server",
    "opencode",
    "headless",
    "cli"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@opencode-ai/sdk": "^1.18.7",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.45.1",
    "jsonc-parser": "^3.2.1",
    "minimatch": "^10.0.1",
    "yaml": "^2.6.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@jugglework/types": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^22.10.2",
    "bun-types": "^1.3.6",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.27.0"
}

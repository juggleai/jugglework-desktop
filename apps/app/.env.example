# Optional local JuggleWork Cloud + IM session for source development.
# Copy this file to `.env.development.local`, fill in the credentials, and
# restart `npm run dev`. Never commit real tokens or credentials.
VITE_DEN_BASE_URL=https://work.juggle.im
VITE_DEN_REQUIRE_SIGNIN=1
VITE_DEN_DEV_AUTH_TOKEN=

# Set the complete group when using a fixed development auth token. These
# values take precedence over IM credentials saved by a previous login and
# are ignored outside Vite development mode.
VITE_DEN_DEV_IM_APP_KEY=
VITE_DEN_DEV_IM_WEBSOCKET_URL=
VITE_DEN_DEV_IM_USER_ID=
VITE_DEN_DEV_IM_TOKEN=
# Optional; defaults to "juggleim".
VITE_DEN_DEV_IM_PROVIDER=

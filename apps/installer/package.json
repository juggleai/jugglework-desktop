{
  "name": "@jugglework/installer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JuggleWork desktop installer: resolves an install-link config, writes desktop bootstrap config, then downloads and installs the newest supported desktop app.",
  "workspaces": [
    "../../packages/install-config"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "compile": "bun build --compile --minify src/index.ts src/server-worker.ts --outfile dist/jugglework-installer",
    "package:mac-dmg": "node scripts/package-mac-dmg.mjs",
    "package:win": "node scripts/package-win.mjs"
  },
  "dependencies": {
    "@jugglework/install-config": "workspace:*",
    "webview-bun": "2.4.0"
  }
}
